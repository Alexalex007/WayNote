rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMapList(lst, maxLen) {
      return lst is list && lst.size() <= maxLen && (lst.size() == 0 || lst[0] is map);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'providerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'providerId', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() <= 100
        && data.providerId is string
        && data.providerId.size() >= 1
        && data.providerId.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserTrip(data, userId, tripId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'syncId', 'name', 'destination', 'startDate', 'endDate',
          'type', 'archived', 'revision', 'clientUpdatedAt', 'metaUpdatedAt',
          'budgetUpdatedAt', 'stops', 'hotels', 'activities', 'activitiesOrderUpdatedAt',
          'themes', 'themesUpdatedAt', 'expenses', 'packingList', 'documents',
          'budget', 'tombstones', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'syncId', 'name', 'destination', 'startDate', 'endDate',
          'type', 'archived', 'revision', 'clientUpdatedAt', 'metaUpdatedAt',
          'budgetUpdatedAt', 'stops', 'hotels', 'activities', 'activitiesOrderUpdatedAt',
          'themes', 'themesUpdatedAt', 'expenses', 'packingList', 'documents',
          'budget', 'tombstones', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == tripId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.syncId is string
        && data.syncId.size() >= 1
        && data.syncId.size() <= 32
        && data.syncId.matches('^[A-Z0-9\\-]+$')
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.destination is string
        && data.destination.size() >= 1
        && data.destination.size() <= 200
        && data.startDate is string
        && data.startDate.size() == 10
        && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate is string
        && data.endDate.size() == 10
        && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (data.type == 'Single' || data.type == 'Multi')
        && data.archived is bool
        && data.revision is int
        && data.revision >= 0
        && data.clientUpdatedAt is number
        && data.clientUpdatedAt >= 0
        && data.metaUpdatedAt is number
        && data.metaUpdatedAt >= 0
        && data.budgetUpdatedAt is number
        && data.budgetUpdatedAt >= 0
        && isValidMapList(data.stops, 20)
        && isValidMapList(data.hotels, 100)
        && data.activities is map
        && data.activitiesOrderUpdatedAt is map
        && data.themes is map
        && data.themesUpdatedAt is map
        && isValidMapList(data.expenses, 1000)
        && isValidMapList(data.packingList, 500)
        && isValidMapList(data.documents, 200)
        && data.budget is map
        && data.tombstones is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 2. Private User Profile Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'providerId', 'updatedAt']);

      allow delete: if false;

      // 3. Private Cloud-Synced Trips Subcollection
      match /trips/{tripId} {
        allow get: if isValidId(userId) && isValidId(tripId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(tripId)
          && isOwner(userId)
          && isValidUserTrip(incoming(), userId, tripId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(tripId)
          && isOwner(userId)
          && isValidUserTrip(incoming(), userId, tripId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action: Sync full trip workspace snapshot
            incoming().diff(existing()).affectedKeys().hasOnly([
              'syncId', 'name', 'destination', 'startDate', 'endDate', 'type',
              'revision', 'clientUpdatedAt', 'metaUpdatedAt', 'budgetUpdatedAt',
              'stops', 'hotels', 'activities', 'activitiesOrderUpdatedAt',
              'themes', 'themesUpdatedAt', 'expenses', 'packingList',
              'documents', 'budget', 'tombstones', 'updatedAt'
            ])
            ||
            // Action: Archive or unarchive trip
            incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'clientUpdatedAt', 'updatedAt'])
          );

        allow delete: if isValidId(userId)
          && isValidId(tripId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
