<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>UI Moments — Interactive Button Gallery</title>
<style>
  :root {
    --bg: #09090b;
    --surface: #111114;
    --surface-hover: #151519;
    --surface-elevated: #1c1c21;
    --border: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(255, 255, 255, 0.18);
    --text: #f4f4f5;
    --text-muted: #71717a;
    --text-dim: #52525b;
    --accent: #ffffff;
    --accent-ink: #09090b;
    --danger: #ef4444;
    --success: #22c55e;
    --rose: #f43f5e;
    --radius-card: 14px;
    --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    overflow-x: hidden;
  }

  button {
    font-family: inherit;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* Top Navbar */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(9, 9, 11, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .topbar-inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: linear-gradient(135deg, #fff 0%, #a1a1aa 100%);
    display: grid;
    place-items: center;
    color: #09090b;
    font-weight: 800;
    font-size: 12px;
  }
  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pill-btn {
    height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: #d4d4d8;
    font-size: 12px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }
  .pill-btn:hover {
    border-color: var(--border-hover);
    color: #fff;
    background: var(--surface-elevated);
  }
  .pill-btn.active {
    background: #fff;
    color: #09090b;
    border-color: #fff;
  }

  /* Hero */
  .container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 36px 24px 64px;
  }
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }
  .hero h1 {
    font-size: clamp(26px, 3.6vw, 38px);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .hero p {
    margin-top: 8px;
    font-size: 14px;
    color: var(--text-muted);
  }

  /* Toolbar / Filter Bar */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0 20px;
    border-top: 1px solid var(--border);
    margin-bottom: 8px;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .tab-btn {
    height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid transparent;
    transition: all 0.18s ease;
  }
  .tab-btn:hover {
    color: var(--text);
    background: rgba(255,255,255,0.04);
  }
  .tab-btn.active {
    background: #fff;
    color: #09090b;
  }
  .tab-count {
    font-size: 11px;
    opacity: 0.65;
  }

  .toolbar-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-wrap svg {
    position: absolute;
    left: 11px;
    width: 14px;
    height: 14px;
    color: var(--text-muted);
    pointer-events: none;
  }
  .search-input {
    height: 32px;
    width: 190px;
    padding: 0 12px 0 32px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 12.5px;
    outline: none;
    transition: border-color 0.2s, width 0.2s;
  }
  .search-input:focus {
    border-color: rgba(255,255,255,0.28);
    width: 220px;
  }
  .search-input::placeholder { color: var(--text-dim); }

  /* Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
    gap: 14px;
  }
  .gallery-grid.cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .gallery-grid.cols-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (max-width: 960px) {
    .gallery-grid.cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gallery-grid.cols-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 580px) {
    .gallery-grid,
    .gallery-grid.cols-3,
    .gallery-grid.cols-4 { grid-template-columns: 1fr; }
    .container { padding: 24px 14px 48px; }
    .topbar-inner { padding: 10px 14px; }
  }

  /* Card */
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.22s ease, background 0.22s ease, transform 0.22s ease;
  }
  .card:hover {
    border-color: var(--border-hover);
    background: var(--surface-hover);
  }
  .card-fav {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 5;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    color: var(--text-dim);
    background: rgba(255,255,255,0.02);
    transition: color 0.18s, background 0.18s, transform 0.18s;
  }
  .card-fav:hover {
    color: #fff;
    background: rgba(255,255,255,0.08);
  }
  .card-fav.saved {
    color: #facc15;
  }
  .card-fav:active { transform: scale(0.86); }

  .card-stage {
    position: relative;
    min-height: 158px;
    padding: 24px 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    user-select: none;
  }

  .card-footer {
    padding: 11px 14px 12px;
    border-top: 1px solid rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: rgba(0,0,0,0.16);
  }
  .card-meta {
    min-width: 0;
  }
  .card-title {
    font-size: 13px;
    font-weight: 550;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-cat {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .details-btn {
    font-size: 11.5px;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 4px 7px;
    border-radius: 6px;
    transition: color 0.16s, background 0.16s;
    flex-shrink: 0;
  }
  .details-btn:hover {
    color: #fff;
    background: rgba(255,255,255,0.06);
  }

  .empty-state {
    grid-column: 1 / -1;
    padding: 56px 20px;
    text-align: center;
    color: var(--text-muted);
    border: 1px dashed var(--border);
    border-radius: var(--radius-card);
  }

  /* ==================== COMPONENT STYLES ==================== */

  /* 1. Squash Play Key */
  .squash-key {
    width: 66px;
    height: 66px;
    border-radius: 18px;
    background: linear-gradient(180deg, #ffffff 0%, #e4e4e7 100%);
    color: #09090b;
    display: grid;
    place-items: center;
    box-shadow: 0 7px 0 #71717a, 0 12px 24px rgba(0,0,0,0.5);
    transition: transform 0.14s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.14s ease;
  }
  .squash-key:hover {
    transform: translateY(-2px);
    box-shadow: 0 9px 0 #71717a, 0 16px 28px rgba(0,0,0,0.55);
  }
  .squash-key:active, .squash-key.squashed {
    transform: translateY(6px) scaleX(1.12) scaleY(0.84);
    box-shadow: 0 1px 0 #71717a, 0 4px 10px rgba(0,0,0,0.4);
  }

  /* 2. Open Settings (Drawer) */
  .open-settings-btn {
    padding: 10px 18px;
    border-radius: 10px;
    background: #1b1b20;
    border: 1px solid rgba(255,255,255,0.14);
    color: #f4f4f5;
    font-size: 13px;
    font-weight: 500;
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
    transition: transform 0.16s, background 0.16s, border-color 0.16s;
  }
  .open-settings-btn:hover {
    background: #232329;
    border-color: rgba(255,255,255,0.26);
  }
  .open-settings-btn:active { transform: scale(0.96); }
  .mini-drawer {
    position: absolute;
    inset: 0;
    background: rgba(9, 9, 11, 0.65);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
    z-index: 4;
  }
  .mini-drawer.open {
    opacity: 1;
    pointer-events: auto;
  }
  .mini-drawer-sheet {
    width: 100%;
    background: #1c1c22;
    border-top: 1px solid rgba(255,255,255,0.15);
    border-radius: 14px 14px 0 0;
    padding: 10px 14px 14px;
    transform: translateY(100%);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mini-drawer.open .mini-drawer-sheet { transform: translateY(0); }
  .drawer-handle {
    width: 28px; height: 3px; border-radius: 99px;
    background: rgba(255,255,255,0.25);
    margin: 0 auto 10px;
  }
  .drawer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    padding: 5px 0;
    color: #d4d4d8;
  }
  .drawer-close {
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 6px;
    background: #fff;
    color: #09090b;
    font-weight: 600;
  }

  /* 3. Like Burst */
  .like-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 999px;
    background: #1a1a1f;
    border: 1px solid rgba(255,255,255,0.12);
    font-size: 13px;
    font-weight: 550;
    transition: border-color 0.2s, background 0.2s, transform 0.15s;
  }
  .like-btn:hover { border-color: rgba(255,255,255,0.24); }
  .like-btn.liked {
    border-color: rgba(244, 63, 94, 0.5);
    background: rgba(244, 63, 94, 0.12);
    color: #fda4af;
  }
  .like-btn svg {
    width: 17px; height: 17px;
    transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1), fill 0.2s, stroke 0.2s;
  }
  .like-btn.liked svg {
    fill: var(--rose);
    stroke: var(--rose);
    transform: scale(1.22);
  }
  .burst-particle {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    pointer-events: none;
    left: 22px;
    top: 50%;
    animation: burstFly 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes burstFly {
    0% { transform: translate(0, 0) scale(1); opacity: 1; }
    100% { transform: translate(var(--dx), var(--dy)) scale(0); opacity: 0; }
  }

  /* 4. Download Ring */
  .dl-btn {
    position: relative;
    height: 40px;
    width: 132px;
    min-width: 44px;
    padding: 0 18px;
    overflow: visible;
    border-radius: 999px;
    background: #1b1b20;
    border: 1px solid rgba(255,255,255,0.14);
    color: #f4f4f5;
    font-size: 13px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.32s cubic-bezier(0.34, 1.35, 0.64, 1);
  }
  .dl-btn:hover { border-color: rgba(255,255,255,0.28); }
  .dl-btn.loading {
    min-width: 44px;
    width: 44px;
    height: 44px;
    padding: 0;
    border-color: rgba(255,255,255,0.08);
  }
  .dl-btn.done {
    width: 118px;
    background: #fff;
    color: #09090b;
    border-color: #fff;
  }
  .dl-ring-svg {
    position: absolute;
    inset: -2px;
    width: calc(100% + 4px);
    height: calc(100% + 4px);
    transform: rotate(-90deg);
    pointer-events: none;
  }

  /* 5. Cart Badge */
  .cart-btn {
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    background: #1b1b20;
    border: 1px solid rgba(255,255,255,0.14);
    display: grid;
    place-items: center;
    color: #f4f4f5;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s;
  }
  .cart-btn:hover { border-color: rgba(255,255,255,0.28); }
  .cart-btn.bump { animation: cartBump 0.38s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes cartBump {
    0% { transform: scale(1); }
    35% { transform: scale(0.88) rotate(-6deg); }
    70% { transform: scale(1.1) rotate(4deg); }
    100% { transform: scale(1) rotate(0); }
  }
  .cart-badge-num {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border-radius: 999px;
    background: #fff;
    color: #09090b;
    font-size: 11px;
    font-weight: 700;
    display: grid;
    place-items: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.45);
    transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cart-badge-num.pop { transform: scale(1.35); }
  .cart-fly {
    position: absolute;
    top: -12px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    pointer-events: none;
    animation: flyUp 0.55s ease-out forwards;
  }
  @keyframes flyUp {
    0% { opacity: 1; transform: translateY(0) scale(0.8); }
    100% { opacity: 0; transform: translateY(-28px) scale(1.15); }
  }

  /* 6. Magnetic Button */
  .mag-wrap {
    width: 100%;
    height: 110px;
    display: grid;
    place-items: center;
  }
  .mag-btn {
    padding: 11px 22px;
    border-radius: 999px;
    background: #fff;
    color: #09090b;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(255,255,255,0.12);
    transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s;
    will-change: transform;
  }
  .mag-btn:active { filter: brightness(0.9); }

  /* 7. Hold to Confirm */
  .hold-btn {
    position: relative;
    overflow: hidden;
    padding: 10px 18px;
    border-radius: 999px;
    background: #1a1a1f;
    border: 1px solid rgba(255,255,255,0.14);
    color: #e4e4e7;
    font-size: 12.5px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    user-select: none;
    touch-action: none;
    transition: border-color 0.2s, transform 0.15s;
  }
  .hold-btn:active { transform: scale(0.97); }
  .hold-fill {
    position: absolute;
    inset: 0;
    background: rgba(239, 68, 68, 0.28);
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }
  .hold-btn.confirmed {
    border-color: rgba(239, 68, 68, 0.65);
    color: #fca5a5;
  }
  .hold-content {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  /* 8. Bookmark Button */
  .bookmark-btn {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #1a1a1f;
    border: 1px solid rgba(255,255,255,0.13);
    display: grid;
    place-items: center;
    transition: border-color 0.2s, background 0.2s;
  }
  .bookmark-btn:hover { border-color: rgba(255,255,255,0.28); }
  .bookmark-btn svg {
    width: 20px; height: 20px;
    stroke: #d4d4d8;
    fill: transparent;
    transition: transform 0.34s cubic-bezier(0.34, 1.56, 0.64, 1), fill 0.2s, stroke 0.2s;
  }
  .bookmark-btn.saved {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.35);
  }
  .bookmark-btn.saved svg {
    fill: #fff;
    stroke: #fff;
    transform: scaleY(1.22) scaleX(0.94);
  }

  /* 9. Paper Plane Send */
  .send-btn {
    position: relative;
    overflow: hidden;
    height: 40px;
    min-width: 112px;
    padding: 0 20px;
    border-radius: 999px;
    background: #fff;
    color: #09090b;
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background 0.25s, color 0.25s, transform 0.15s;
  }
  .send-btn:active { transform: scale(0.95); }
  .send-btn svg {
    width: 15px; height: 15px;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s;
  }
  .send-btn.sending svg {
    transform: translate(36px, -28px) rotate(18deg) scale(0.75);
    opacity: 0;
  }
  .send-btn.sent {
    background: #22c55e;
    color: #052e16;
  }

  /* 10. Copy Button */
  .copy-btn {
    height: 38px;
    padding: 0 16px;
    border-radius: 10px;
    background: #1b1b20;
    border: 1px solid rgba(255,255,255,0.14);
    color: #f4f4f5;
    font-size: 12.5px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
  }
  .copy-btn:hover { border-color: rgba(255,255,255,0.28); background: #222228; }
  .copy-btn.copied {
    background: rgba(34, 197, 94, 0.14);
    border-color: rgba(34, 197, 94, 0.5);
    color: #86efac;
  }

  /* 11. Stretch Toggle */
  .stretch-toggle {
    position: relative;
    width: 68px;
    height: 36px;
    border-radius: 999px;
    background: #27272a;
    border: 1px solid rgba(255,255,255,0.1);
    padding: 4px;
    transition: background 0.28s ease;
  }
  .stretch-toggle.on { background: #fff; }
  .stretch-thumb {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: #fff;
    transition: transform 0.34s cubic-bezier(0.34, 1.4, 0.64, 1), width 0.18s ease, background 0.25s;
  }
  .stretch-toggle.on .stretch-thumb {
    background: #09090b;
    transform: translateX(32px);
  }
  .stretch-toggle.stretching .stretch-thumb {
    width: 40px;
  }
  .stretch-toggle.on.stretching .stretch-thumb {
    transform: translateX(18px);
  }

  /* 12. Ink Switch */
  .ink-switch {
    position: relative;
    width: 68px;
    height: 36px;
    border-radius: 999px;
    background: #1f1f24;
    border: 1px solid rgba(255,255,255,0.14);
    overflow: hidden;
    padding: 4px;
  }
  .ink-flood {
    position: absolute;
    left: 17px;
    top: 17px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ink-switch.on .ink-flood {
    transform: translate(-50%, -50%) scale(14);
  }
  .ink-thumb {
    position: relative;
    z-index: 2;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.36s cubic-bezier(0.34, 1.45, 0.64, 1), background 0.25s;
  }
  .ink-switch.on .ink-thumb {
    transform: translateX(32px);
    background: #09090b;
  }

  /* 13. Rocker Switch */
  .rocker-shell {
    width: 78px;
    height: 40px;
    padding: 4px;
    border-radius: 10px;
    background: #0b0b0d;
    border: 1px solid rgba(255,255,255,0.12);
    perspective: 260px;
  }
  .rocker-plate {
    width: 100%;
    height: 100%;
    border-radius: 6px;
    background: linear-gradient(90deg, #2b2b31 0%, #1c1c21 50%, #34343c 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    font-size: 11px;
    font-weight: 700;
    color: #a1a1aa;
    transform: rotateY(-16deg);
    box-shadow: -4px 0 10px rgba(0,0,0,0.6), inset 1px 0 0 rgba(255,255,255,0.12);
    transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.24s;
  }
  .rocker-shell.on .rocker-plate {
    transform: rotateY(16deg);
    box-shadow: 4px 0 10px rgba(0,0,0,0.6), inset -1px 0 0 rgba(255,255,255,0.2);
  }
  .rocker-shell.on .rocker-i { color: #fff; text-shadow: 0 0 8px rgba(255,255,255,0.65); }
  .rocker-shell:not(.on) .rocker-o { color: #fff; }

  /* 14. Blank Toggle */
  .blank-toggle {
    width: 64px;
    height: 34px;
    border-radius: 8px;
    background: #1c1c21;
    border: 1px solid rgba(255,255,255,0.14);
    padding: 4px;
    display: flex;
    align-items: center;
    transition: background 0.2s, border-color 0.2s;
  }
  .blank-toggle.on {
    background: #f4f4f5;
    border-color: #f4f4f5;
  }
  .blank-knob {
    width: 24px;
    height: 24px;
    border-radius: 5px;
    background: #f4f4f5;
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s;
  }
  .blank-toggle.on .blank-knob {
    transform: translateX(30px);
    background: #09090b;
  }

  /* 15. Ball Toggle */
  .ball-toggle {
    width: 72px;
    height: 30px;
    border-radius: 999px;
    background: #18181c;
    border: 1px solid rgba(255,255,255,0.12);
    position: relative;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.75);
  }
  .ball-sphere {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffffff, #a1a1aa);
    box-shadow: 0 2px 6px rgba(0,0,0,0.6);
    transition: transform 0.42s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .ball-toggle.on .ball-sphere {
    transform: translateX(42px) rotate(360deg);
  }

  /* 16. Alignment Switch */
  .align-switch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 40px);
    padding: 4px;
    border-radius: 11px;
    background: #1a1a1f;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .align-indicator {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 40px;
    height: 32px;
    border-radius: 7px;
    background: #fff;
    transition: transform 0.28s cubic-bezier(0.34, 1.35, 0.64, 1);
    pointer-events: none;
  }
  .align-opt {
    position: relative;
    z-index: 1;
    height: 32px;
    display: grid;
    place-items: center;
    color: #a1a1aa;
    transition: color 0.2s;
  }
  .align-opt.active { color: #09090b; }

  /* 17. Gooey Tab Bar */
  .gooey-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 999px;
    background: #18181c;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .gooey-blobs {
    position: absolute;
    inset: 0;
    filter: url(#gooey-filter);
    pointer-events: none;
  }
  .gooey-pill {
    position: absolute;
    top: 6px;
    left: 8px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.42s cubic-bezier(0.34, 1.38, 0.64, 1);
  }
  .gooey-trail {
    position: absolute;
    top: 8px;
    left: 10px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.56s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .gooey-tab {
    position: relative;
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #a1a1aa;
    transition: color 0.24s;
  }
  .gooey-tab.active { color: #09090b; }

  /* 18-26. Click Effects ("Try it" buttons) */
  .try-btn {
    position: relative;
    padding: 10px 22px;
    border-radius: 10px;
    background: #1d1d22;
    border: 1px solid rgba(255,255,255,0.16);
    color: #f4f4f5;
    font-size: 13px;
    font-weight: 550;
    transition: background 0.16s, border-color 0.16s;
  }
  .try-btn:hover {
    background: #26262d;
    border-color: rgba(255,255,255,0.3);
  }
  .fx-bounce { animation: fxBounce 0.65s cubic-bezier(0.28, 0.84, 0.42, 1); }
  @keyframes fxBounce {
    0%   { transform: translateY(0) scale(1); }
    20%  { transform: translateY(-20px) scale(1.06); }
    45%  { transform: translateY(0) scale(1.08, 0.9); }
    65%  { transform: translateY(-10px) scale(1.02); }
    82%  { transform: translateY(0) scale(1.03, 0.96); }
    100% { transform: translateY(0) scale(1); }
  }
  .fx-pop { animation: fxPop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes fxPop {
    0% { transform: scale(1); }
    35% { transform: scale(0.84); }
    70% { transform: scale(1.18); }
    100% { transform: scale(1); }
  }
  .fx-jelly { animation: fxJelly 0.72s ease; }
  @keyframes fxJelly {
    0%   { transform: scale(1, 1); }
    25%  { transform: scale(1.24, 0.76); }
    45%  { transform: scale(0.82, 1.18); }
    65%  { transform: scale(1.12, 0.88); }
    82%  { transform: scale(0.95, 1.05); }
    100% { transform: scale(1, 1); }
  }
  .fx-swing {
    transform-origin: top center;
    animation: fxSwing 0.72s ease;
  }
  @keyframes fxSwing {
    0%   { transform: rotate(0deg); }
    20%  { transform: rotate(16deg); }
    40%  { transform: rotate(-12deg); }
    60%  { transform: rotate(7deg); }
    80%  { transform: rotate(-4deg); }
    100% { transform: rotate(0deg); }
  }
  .fx-squeeze { animation: fxSqueeze 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes fxSqueeze {
    0%   { transform: scale(1, 1); }
    35%  { transform: scale(0.74, 1.22); }
    70%  { transform: scale(1.1, 0.92); }
    100% { transform: scale(1, 1); }
  }
  .fx-shake { animation: fxShake 0.48s ease; }
  @keyframes fxShake {
    0%, 100% { transform: translateX(0); }
    18% { transform: translateX(-9px); }
    36% { transform: translateX(8px); }
    54% { transform: translateX(-6px); }
    72% { transform: translateX(4px); }
    88% { transform: translateX(-2px); }
  }
  .fx-tada { animation: fxTada 0.72s ease; }
  @keyframes fxTada {
    0%   { transform: scale(1) rotate(0); }
    15%  { transform: scale(0.9) rotate(-4deg); }
    30%, 50%, 70% { transform: scale(1.14) rotate(5deg); }
    40%, 60%, 80% { transform: scale(1.14) rotate(-5deg); }
    100% { transform: scale(1) rotate(0); }
  }
  .fx-flicker { animation: fxFlicker 0.55s linear; }
  @keyframes fxFlicker {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 rgba(255,255,255,0); }
    15% { opacity: 0.25; }
    30% { opacity: 1; box-shadow: 0 0 18px rgba(255,255,255,0.45); }
    45% { opacity: 0.2; }
    65% { opacity: 1; box-shadow: 0 0 14px rgba(255,255,255,0.35); }
    80% { opacity: 0.55; }
  }
  .fx-jerk { animation: fxJerk 0.46s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes fxJerk {
    0% { transform: translate(0, 0) rotate(0); }
    22% { transform: translate(-10px, -6px) rotate(-7deg); }
    55% { transform: translate(6px, 2px) rotate(3deg); }
    100% { transform: translate(0, 0) rotate(0); }
  }
  .pop-float {
    position: absolute;
    left: 50%;
    top: 50%;
    font-size: 13px;
    pointer-events: none;
    animation: popFloat 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes popFloat {
    0% { transform: translate(-50%, -50%) scale(0.4); opacity: 1; }
    100% { transform: translate(calc(-50% + var(--px)), calc(-50% + var(--py))) scale(1.15); opacity: 0; }
  }

  /* 27. Swipe to Confirm */
  .swipe-track {
    position: relative;
    width: 176px;
    height: 44px;
    border-radius: 999px;
    background: #1a1a1f;
    border: 1px solid rgba(255,255,255,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
  }
  .swipe-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .swipe-fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 44px;
    background: rgba(255,255,255,0.1);
    border-radius: 999px;
    pointer-events: none;
  }
  .swipe-thumb {
    position: absolute;
    left: 4px;
    top: 4px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #fff;
    color: #09090b;
    display: grid;
    place-items: center;
    cursor: grab;
    box-shadow: 0 2px 8px rgba(0,0,0,0.45);
    z-index: 2;
  }
  .swipe-thumb:active { cursor: grabbing; }
  .swipe-track.confirmed {
    background: rgba(34, 197, 94, 0.16);
    border-color: rgba(34, 197, 94, 0.45);
  }
  .swipe-track.confirmed .swipe-label { color: #86efac; }

  /* 28. Elastic Slider */
  .elastic-slider {
    position: relative;
    width: 170px;
    padding-top: 28px;
    touch-action: none;
  }
  .elastic-badge {
    position: absolute;
    top: 0;
    left: 63%;
    transform: translateX(-50%);
    min-width: 34px;
    height: 22px;
    padding: 0 7px;
    border-radius: 999px;
    background: #fff;
    color: #09090b;
    font-size: 11px;
    font-weight: 700;
    display: grid;
    place-items: center;
    transition: transform 0.14s ease;
    pointer-events: none;
  }
  .elastic-rail {
    position: relative;
    height: 8px;
    border-radius: 999px;
    background: #27272a;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1);
  }
  .elastic-progress {
    height: 100%;
    width: 63%;
    background: #fff;
    border-radius: 999px;
    pointer-events: none;
  }

  /* 29. Plan Picker */
  .plan-picker {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
    max-width: 196px;
  }
  .plan-card {
    padding: 10px 10px 9px;
    border-radius: 10px;
    background: #18181c;
    border: 1px solid rgba(255,255,255,0.1);
    text-align: left;
    transition: border-color 0.2s, background 0.2s, transform 0.16s;
  }
  .plan-card:hover { border-color: rgba(255,255,255,0.22); }
  .plan-card.active {
    background: #222228;
    border-color: #fff;
    transform: translateY(-2px);
  }
  .plan-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
    font-weight: 600;
    color: #e4e4e7;
  }
  .plan-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    border: 1.5px solid #71717a;
    transition: all 0.2s;
  }
  .plan-card.active .plan-dot {
    border-color: #fff;
    background: #fff;
    box-shadow: 0 0 0 2px #222228 inset;
  }
  .plan-price {
    margin-top: 5px;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
  }
  .plan-price span {
    font-size: 10px;
    font-weight: 400;
    color: var(--text-muted);
  }

  /* 30. Pebble Rating */
  .pebble-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pebble-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #27272a;
    border: 1px solid rgba(255,255,255,0.1);
    transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s, border-color 0.2s;
  }
  .pebble-dot:hover { transform: scale(1.26) translateY(-3px); }
  .pebble-dot.filled {
    background: #fff;
    border-color: #fff;
    transform: scale(1.1);
  }
  .pebble-dot.wave { transform: scale(1.22) translateY(-3px); }


  /* ==================== DATA VIZ COMPONENTS ==================== */
  /* 31. Live Telemetry Pill */
  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 15px;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.42);
    color: #86efac;
    font-size: 12.5px;
    font-weight: 600;
    transition: all 0.22s ease;
  }
  .live-pill.paused {
    background: #1b1b20;
    border-color: rgba(255,255,255,0.14);
    color: #a1a1aa;
  }
  .live-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
  }
  .live-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1.5px solid #22c55e;
    animation: livePulse 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .live-pill.paused .live-dot {
    background: #71717a;
  }
  .live-pill.paused .live-dot::after {
    animation: none;
    opacity: 0;
  }
  @keyframes livePulse {
    0% { transform: scale(0.7); opacity: 0.9; }
    100% { transform: scale(2.1); opacity: 0; }
  }
  .live-rate {
    font-variant-numeric: tabular-nums;
    font-size: 11px;
    opacity: 0.8;
    padding-left: 6px;
    border-left: 1px solid rgba(255,255,255,0.15);
  }

  /* 32. Timeframe Switcher */
  .tf-switch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 34px);
    padding: 3px;
    border-radius: 10px;
    background: #18181c;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .tf-pill {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 34px;
    height: 28px;
    border-radius: 7px;
    background: #fff;
    transition: transform 0.24s cubic-bezier(0.34, 1.38, 0.64, 1);
    pointer-events: none;
  }
  .tf-btn {
    position: relative;
    z-index: 1;
    height: 28px;
    font-size: 11px;
    font-weight: 600;
    color: #a1a1aa;
    transition: color 0.18s;
  }
  .tf-btn.active { color: #09090b; }

  /* 33. Export CSV */
  .export-btn {
    position: relative;
    overflow: hidden;
    height: 40px;
    min-width: 132px;
    padding: 0 16px;
    border-radius: 10px;
    background: #1a1a1f;
    border: 1px solid rgba(255,255,255,0.15);
    color: #f4f4f5;
    font-size: 12.5px;
    font-weight: 550;
