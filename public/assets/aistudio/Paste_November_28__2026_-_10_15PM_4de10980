    opacity: 0.35;
  }
  .swap-circle {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    color: #09090b;
    display: grid;
    place-items: center;
    transition: transform 0.38s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .swap-circle:active { transform: scale(0.9); }

  /* 37. Traveler Counter */
  .stepper-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 5px 7px;
    border-radius: 999px;
    background: #18181c;
    border: 1px solid rgba(255,255,255,0.12);
  }
  .step-op {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #27272a;
    color: #f4f4f5;
