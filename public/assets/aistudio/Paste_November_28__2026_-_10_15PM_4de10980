      const now = ctx.currentTime;
      [440, 660].forEach((f, i) => {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(f, now + i * 0.035);
        g.gain.setValueAtTime(0.038, now + i * 0.035);
        g.gain.exponentialRampToValueAtTime(0.001, now + i * 0.035 + 0.032);
        osc.connect(g); g.connect(ctx.destination);
        osc.start(now + i * 0.035); osc.stop(now + i * 0.035 + 0.035);
