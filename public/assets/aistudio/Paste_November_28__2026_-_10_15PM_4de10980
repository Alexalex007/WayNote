    left: 0; bottom: 0;
    height: 3px;
    width: 0%;
    background: #38bdf8;
    transition: width 0.08s linear;
  }
  .export-btn.done {
    background: rgba(56, 189, 248, 0.14);
    border-color: rgba(56, 189, 248, 0.55);
    color: #7dd3fc;
  }

  /* 34. Chart Type Morph */
  .chart-morph-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 16px 0 12px;
    border-radius: 12px;
    background: #1a1a1f;
    border: 1px solid rgba(255,255,255,0.14);
    color: #f4f4f5;
    font-size: 12.5px;
    font-weight: 550;
    transition: border-color 0.2s, transform 0.15s;
  }
  .chart-morph-btn:hover { border-color: rgba(255,255,255,0.28); }
  .chart-morph-btn:active { transform: scale(0.95); }
  .chart-icon-box {
    width: 26px; height: 26px;
    border-radius: 7px;
    background: rgba(255,255,255,0.08);
    display: grid;
    place-items: center;
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .chart-morph-btn.spin .chart-icon-box { transform: scale(0.75) rotate(-18deg); }

  /* 35. Metric Compare Toggle */
  .compare-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: #1a1a1f;
    border: 1px solid rgba(255,255,255,0.14);
    font-size: 12.5px;
    font-weight: 600;
    transition: all 0.24s ease;
  }
  .compare-btn.active {
    background: rgba(34, 197, 94, 0.12);
    border-color: rgba(34, 197, 94, 0.45);
  }
  .compare-badge {
    padding: 2px 7px;
