    font-size: 11px;
    font-variant-numeric: tabular-nums;
    background: rgba(255,255,255,0.08);
    color: #a1a1aa;
    transition: all 0.24s ease;
  }
  .compare-btn.active .compare-badge {
    background: #22c55e;
    color: #052e16;
  }

  /* ==================== TRAVEL PLANNING COMPONENTS ==================== */
  /* 36. Route Swap Button */
  .route-swap {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #18181c;
    border: 1px solid rgba(255,255,255,0.13);
  }
  .airport-code {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    min-width: 34px;
    text-align: center;
    transition: transform 0.24s ease, opacity 0.2s ease;
  }
