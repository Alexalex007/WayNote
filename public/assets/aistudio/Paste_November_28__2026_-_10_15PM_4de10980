          setPos(0, true);
        };

        thumb.addEventListener('pointerdown', (e) => {
          if (confirmed) return;
          dragging = true;
          startX = e.clientX - curX;
          thumb.setPointerCapture(e.pointerId);
        });
        thumb.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          setPos(e.clientX - startX, false);
