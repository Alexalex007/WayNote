    position: relative;
    height: 40px;
    min-width: 130px;
    padding: 0 18px;
    border-radius: 10px;
    background: #1b1b20;
    border: 1.5px dashed rgba(255,255,255,0.24);
    color: #f4f4f5;
    font-size: 12.5px;
    font-weight: 600;
    display: inline-flex;
