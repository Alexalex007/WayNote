<script>
(function () {
  // Rich Web Audio Tactile Foley Engine
  let audioCtx = null;
  let soundEnabled = true;

  function getCtx() {
    if (!soundEnabled) return null;
    try {
      if (!audioCtx) {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        audioCtx = new AC();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    } catch (e) {
      return null;
    }
  }

  function playClick(freq = 520, dur = 0.045, type = 'sine') {
    const ctx = getCtx();
    if (!ctx) return;
    const now = ctx.currentTime;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, now);
    osc.frequency.exponentialRampToValueAtTime(Math.max(40, freq * 0.62), now + dur);
    gain.gain.setValueAtTime(0.075, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + dur);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(now);
    osc.stop(now + dur);
  }

  // Helper for short filtered noise transient (gives realistic physical click/tap texture)
  function playNoiseBurst(ctx, dur, freq, q, vol, offset = 0) {
    const len = Math.max(64, Math.floor(ctx.sampleRate * dur));
    const buf = ctx.createBuffer(1, len, ctx.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 1.8);
    const src = ctx.createBufferSource();
    src.buffer = buf;
    const f = ctx.createBiquadFilter();
    f.type = 'bandpass';
    f.frequency.setValueAtTime(freq, ctx.currentTime + offset);
    f.Q.value = q;
    const g = ctx.createGain();
    g.gain.setValueAtTime(vol, ctx.currentTime + offset);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + offset + dur);
    src.connect(f); f.connect(g); g.connect(ctx.destination);
    src.start(ctx.currentTime + offset);
  }

  const SFX = {
    // 1. Mechanical keycap thock + crisp top-out transient
    key(high = true) {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      playNoiseBurst(ctx, 0.012, high ? 2800 : 2100, 1.8, 0.09);
      const osc = ctx.createOscillator();
      const lp = ctx.createBiquadFilter();
      const g = ctx.createGain();
      osc.type = 'triangle';
      lp.type = 'lowpass'; lp.frequency.value = 950;
      osc.frequency.setValueAtTime(high ? 290 : 225, now);
      osc.frequency.exponentialRampToValueAtTime(78, now + 0.042);
      g.gain.setValueAtTime(0.16, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.048);
      osc.connect(lp); lp.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.052);
    },
    // 2. Tactile hardware rocker/lever toggle (warm filtered dual-click, zero harsh buzz)
    rocker(on) {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      playNoiseBurst(ctx, 0.01, on ? 2400 : 1800, 2.2, 0.075, 0);
      playNoiseBurst(ctx, 0.012, on ? 3200 : 1400, 2.0, 0.085, 0.02);
      [0, 0.02].forEach((off, idx) => {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'triangle';
        const f0 = on ? (idx === 0 ? 210 : 460) : (idx === 0 ? 380 : 190);
        osc.frequency.setValueAtTime(f0, now + off);
        osc.frequency.exponentialRampToValueAtTime(110, now + off + 0.022);
        g.gain.setValueAtTime(0.09, now + off);
        g.gain.exponentialRampToValueAtTime(0.001, now + off + 0.026);
        osc.connect(g); g.connect(ctx.destination);
        osc.start(now + off); osc.stop(now + off + 0.028);
      });
    },
    // 3. Clean airy bubble pop (Like, Pop, Bookmark, Follow)
    pop(pitch = 1) {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(320 * pitch, now);
      osc.frequency.exponentialRampToValueAtTime(880 * pitch, now + 0.058);
      g.gain.setValueAtTime(0.095, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.072);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.076);
    },
    // 4. Silky air whoosh (Paper Plane, Drawer, Route Swap, Curtain Fill)
    whoosh(up = true) {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      const len = Math.floor(ctx.sampleRate * 0.17);
      const buf = ctx.createBuffer(1, len, ctx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) {
        const env = Math.sin((i / len) * Math.PI);
        d[i] = (Math.random() * 2 - 1) * env;
      }
      const src = ctx.createBufferSource();
      src.buffer = buf;
      const f = ctx.createBiquadFilter();
      f.type = 'bandpass'; f.Q.value = 1.9;
      f.frequency.setValueAtTime(up ? 420 : 1650, now);
      f.frequency.exponentialRampToValueAtTime(up ? 1950 : 390, now + 0.16);
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.11, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.17);
      src.connect(f); f.connect(g); g.connect(ctx.destination);
      src.start(now);
    },
    // 5. Warm harmonic two-note success chime (E5 -> B5)
    chime() {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      [659.25, 987.77].forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now + i * 0.07);
        g.gain.setValueAtTime(0.075, now + i * 0.07);
        g.gain.exponentialRampToValueAtTime(0.001, now + i * 0.07 + 0.24);
        osc.connect(g); g.connect(ctx.destination);
        osc.start(now + i * 0.07); osc.stop(now + i * 0.07 + 0.26);
      });
    },
    // 6. Sparkling celebration fanfare (Confetti, Tada)
    fanfare() {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      [523.25, 659.25, 783.99, 1046.5].forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now + i * 0.052);
        g.gain.setValueAtTime(0.07, now + i * 0.052);
        g.gain.exponentialRampToValueAtTime(0.001, now + i * 0.052 + 0.22);
        osc.connect(g); g.connect(ctx.destination);
        osc.start(now + i * 0.052); osc.stop(now + i * 0.052 + 0.24);
      });
    },
    // 7. Precision Swiss-watch / Digital Crown detent tick
    tick(pitch = 1) {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      playNoiseBurst(ctx, 0.007, 3600 * pitch, 3.0, 0.055);
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(1250 * pitch, now);
      osc.frequency.exponentialRampToValueAtTime(420 * pitch, now + 0.014);
      g.gain.setValueAtTime(0.055, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.016);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.018);
    },
    // 8. Soft rubbery spring boing (Bounce, Jelly, Squeeze, Stretch Toggle)
    boing(pitch = 1) {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(220 * pitch, now);
      osc.frequency.exponentialRampToValueAtTime(510 * pitch, now + 0.065);
      osc.frequency.exponentialRampToValueAtTime(320 * pitch, now + 0.145);
      g.gain.setValueAtTime(0.085, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.16);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.17);
    },
    // 9. Pure water-drop liquid bloop (Ink Switch, Gooey Tabs, Ripple, Liquid Glass)
    liquid(up = true) {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(up ? 290 : 580, now);
      osc.frequency.exponentialRampToValueAtTime(up ? 720 : 280, now + 0.095);
      g.gain.setValueAtTime(0.09, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.11);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.12);
    },
    // 10. Warm muted double-thud warning (Shake, Hold Delete, Jerk — no harsh sawtooth!)
    warn() {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      [0, 0.075].forEach((off, idx) => {
        const osc = ctx.createOscillator();
        const lp = ctx.createBiquadFilter();
        const g = ctx.createGain();
        osc.type = 'triangle';
        lp.type = 'lowpass'; lp.frequency.value = 380;
        osc.frequency.setValueAtTime(idx === 0 ? 185 : 145, now + off);
        osc.frequency.exponentialRampToValueAtTime(95, now + off + 0.065);
        g.gain.setValueAtTime(0.11, now + off);
        g.gain.exponentialRampToValueAtTime(0.001, now + off + 0.07);
        osc.connect(lp); lp.connect(g); g.connect(ctx.destination);
        osc.start(now + off); osc.stop(now + off + 0.075);
      });
    },
    // 11. Subtle electric neon spark (Flicker, Neon Outline)
    zap() {
      const ctx = getCtx(); if (!ctx) return;
      const now = ctx.currentTime;
      [0, 0.045, 0.09].forEach((t, i) => {
