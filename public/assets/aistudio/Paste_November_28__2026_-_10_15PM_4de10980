        const updateFromEvent = (e, tilt = 0) => {
          const rect = rail.getBoundingClientRect();
          const raw = (e.clientX - rect.left) / rect.width;
          const ratio = Math.max(0, Math.min(1, raw));
          val = Math.round(ratio * 100);
          prog.style.width = `${val}%`;
          badge.style.left = `${val}%`;
          badge.textContent = String(val);
          const clampedTilt = Math.max(-18, Math.min(18, tilt));
          badge.style.transform = `translateX(-50%) rotate(${clampedTilt}deg) scale(${dragging ? 1.12 : 1})`;
          // Elastic rubber-band stretch when pulling past left/right edge
          if (raw < 0) {
            const stretch = Math.min(0.14, Math.abs(raw) * 0.25);
            rail.style.transform = `translateX(${-stretch * 36}px) scaleX(${1 + stretch}) scaleY(${1 - stretch * 0.8})`;
          } else if (raw > 1) {
            const stretch = Math.min(0.14, (raw - 1) * 0.25);
            rail.style.transform = `translateX(${stretch * 36}px) scaleX(${1 + stretch}) scaleY(${1 - stretch * 0.8})`;
          } else {
            rail.style.transform = 'none';
          }
        };

        rail.addEventListener('pointerdown', (e) => {
          dragging = true;
          lastX = e.clientX;
          rail.setPointerCapture(e.pointerId);
          updateFromEvent(e, 0);
          playClick(520);
        });
        let lastTickVal = val;
