        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now);
        g.gain.setValueAtTime(i === 0 ? 0.07 : 0.025 / i, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + 0.34 - i * 0.06);
