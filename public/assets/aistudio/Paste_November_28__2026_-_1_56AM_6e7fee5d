  .step-val {
    min-width: 64px;
    text-align: center;
    font-size: 12.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .step-val.bump { transform: scale(1.18); }

  /* 38. Itinerary Save Stamp */
  .stamp-btn {
    position: relative;
    height: 40px;
    min-width: 130px;
    padding: 0 18px;
    border-radius: 10px;
    background: #1b1b20;
    border: 1.5px dashed rgba(255,255,255,0.24);
    color: #f4f4f5;
    font-size: 12.5px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
