  }

  /* 39. Map / List View Pill */
  .view-pill {
    position: relative;
    display: grid;
    grid-template-columns: 74px 74px;
    padding: 4px;
    border-radius: 999px;
    background: #18181c;
    border: 1px solid rgba(255,255,255,0.12);
  }
  .view-pill-bg {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 74px;
    height: 30px;
    border-radius: 999px;
    background: #fff;
    transition: transform 0.28s cubic-bezier(0.34, 1.38, 0.64, 1);
    pointer-events: none;
