          void valEl.offsetWidth;
          valEl.classList.add('bump');
          setTimeout(() => valEl.classList.remove('bump'), 180);
          SFX.tick(delta > 0 ? 1.15 : 0.85);
        };
        decBtn.addEventListener('click', () => update(-1));
        incBtn.addEventListener('click', () => update(1));
        container.appendChild(wrap);
      }
    },
    {
      id: 'itinerary-stamp',
      title: 'Itinerary Stamp',
      subtitle: 'Travel · Action',
      category: 'Travel',
      desc: '護照印章風格的「加入行程」按鈕：點擊後以微傾斜角度蓋章固定並發出沉實印章聲，轉為純白「In Trip ✓」。',
      code: `.stamp-btn.stamped {
  transform: rotate(-2.5deg) scale(1.03);
  border-style: solid;
}`,
      mount(container) {
        let added = false;
        const btn = document.createElement('button');
        btn.className = 'stamp-btn';
        btn.type = 'button';
        const render = () => {
          btn.classList.toggle('stamped', added);
          btn.innerHTML = added
            ? `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M5 13l4 4L19 7"/></svg><span>In Trip</span>`
            : `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg><span>Add to Trip</span>`;
        };
        render();
        btn.addEventListener('click', () => {
          added = !added;
          render();
          added ? SFX.stamp() : SFX.tick(0.8);
        });
        container.appendChild(btn);
      }
    },
    {
      id: 'map-list-pill',
      title: 'Map / List Switch',
      subtitle: 'Travel · View',
      category: 'Travel',
      desc: '景點與飯店搜尋頁常見的懸浮地圖／清單切換膠囊，點擊時純白滑塊彈性平順滑動並切換視圖狀態。',
      code: `bg.style.transform = \`translateX(\${mode === 'list' ? 74 : 0}px)\`;`,
      mount(container) {
        let mode = 'map';
        const wrap = document.createElement('div');
        wrap.className = 'view-pill';
        wrap.innerHTML = `
          <div class="view-pill-bg"></div>
          <button type="button" class="view-pill-opt active" data-m="map">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 6v16l7-4 8 4 7-4V2l-7 4-8-4-7 4z"/></svg>
            <span>Map</span>
          </button>
          <button type="button" class="view-pill-opt" data-m="list">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
            <span>List</span>
          </button>
        `;
        const bg = wrap.querySelector('.view-pill-bg');
        const opts = wrap.querySelectorAll('.view-pill-opt');
        opts.forEach((btn) => {
          btn.addEventListener('click', () => {
            mode = btn.getAttribute('data-m');
            bg.style.transform = `translateX(${mode === 'list' ? 74 : 0}px)`;
            opts.forEach((o) => o.classList.toggle('active', o.getAttribute('data-m') === mode));
            SFX.tick(mode === 'map' ? 1.0 : 1.18);
          });
        });
        container.appendChild(wrap);
      }
    },
    {
      id: 'price-alert-bell',
      title: 'Price Alert Bell',
      subtitle: 'Travel · Alert',
      category: 'Travel',
      desc: '機票與房價降價追蹤鈴鐺：點擊啟用時鈴鐺左右搖晃並響起清脆雙頻鈴聲，切換為金色追蹤狀態。',
      code: `@keyframes bellRing {
  20% { transform: rotate(18deg); }
  40% { transform: rotate(-16deg); }
}`,
      mount(container) {
        let on = false;
        const btn = document.createElement('button');
        btn.className = 'alert-bell-btn';
        btn.type = 'button';
        btn.innerHTML = `
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
          <span class="bell-label">Price Alert</span>
        `;
        const svg = btn.querySelector('svg');
        const label = btn.querySelector('.bell-label');
        btn.addEventListener('click', () => {
          on = !on;
          btn.classList.toggle('active', on);
          label.textContent = on ? 'Tracking' : 'Price Alert';
          if (on) {
            svg.classList.remove('ringing');
            void svg.offsetWidth;
            svg.classList.add('ringing');
            SFX.bell();
          } else {
            SFX.tick(0.75);
          }
        });
        container.appendChild(btn);
      }
    }

  ];

  // State
  let activeCategory = 'All';
  let searchQuery = '';
  let onlyFavorites = false;
  let colsMode = 'auto'; // 'auto' | '3' | '4'
  const favorites = new Set();

  try {
    const saved = JSON.parse(localStorage.getItem('ui_moments_favs') || '[]');
    if (Array.isArray(saved)) saved.forEach((id) => favorites.add(id));
  } catch (e) {}

  function saveFavs() {
    try {
      localStorage.setItem('ui_moments_favs', JSON.stringify(Array.from(favorites)));
    } catch (e) {}
    document.getElementById('favCount').textContent = String(favorites.size);
  }

  // Categories
  const CATEGORIES = ['All', 'Buttons', 'Switches', 'Click Effects', 'Controls', 'Data Viz', 'Travel'];

  function renderTabs() {
    const tabsEl = document.getElementById('categoryTabs');
    tabsEl.innerHTML = '';
    CATEGORIES.forEach((cat) => {
      const count = cat === 'All'
        ? COMPONENTS.length
        : COMPONENTS.filter((c) => c.category === cat).length;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'tab-btn' + (activeCategory === cat ? ' active' : '');
      btn.innerHTML = `<span>${cat}</span><span class="tab-count">${count}</span>`;
      btn.addEventListener('click', () => {
        activeCategory = cat;
        playClick(540);
        renderTabs();
        renderGrid();
      });
      tabsEl.appendChild(btn);
    });
  }

  function openModal(comp) {
    document.getElementById('modalTitle').textContent = comp.title;
    document.getElementById('modalSub').textContent = `${comp.category} · ${comp.subtitle}`;
    document.getElementById('modalDesc').textContent = comp.desc;
    document.getElementById('modalCode').textContent = comp.code;
    const preview = document.getElementById('modalPreview');
    preview.innerHTML = '';
    comp.mount(preview);
    document.getElementById('detailsModal').classList.add('open');
    document.getElementById('modalCopyBtn').onclick = () => {
      copyText(comp.code);
      showToast(`已複製 ${comp.title} 程式碼片段`);
      playClick(760);
    };
  }

  function closeModal() {
    document.getElementById('detailsModal').classList.remove('open');
  }

  function renderGrid() {
    const grid = document.getElementById('galleryGrid');
    grid.className = 'gallery-grid' + (colsMode === '3' ? ' cols-3' : colsMode === '4' ? ' cols-4' : '');
    grid.innerHTML = '';

    const q = searchQuery.trim().toLowerCase();
    const list = COMPONENTS.filter((c) => {
      if (activeCategory !== 'All' && c.category !== activeCategory) return false;
      if (onlyFavorites && !favorites.has(c.id)) return false;
      if (q && !(c.title.toLowerCase().includes(q) || c.subtitle.toLowerCase().includes(q) || c.category.toLowerCase().includes(q))) {
        return false;
      }
      return true;
    });

    if (list.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'empty-state';
      empty.textContent = onlyFavorites
        ? '目前尚未收藏任何按鈕，點擊卡片右上角 ★ 即可加入收藏。'
        : '找不到符合條件的按鈕元件。';
      grid.appendChild(empty);
      return;
    }

    list.forEach((comp) => {
      const card = document.createElement('article');
      card.className = 'card';

      const favBtn = document.createElement('button');
      favBtn.type = 'button';
      favBtn.className = 'card-fav' + (favorites.has(comp.id) ? ' saved' : '');
      favBtn.setAttribute('aria-label', 'Favorite');
      favBtn.textContent = favorites.has(comp.id) ? '★' : '☆';
      favBtn.addEventListener('click', () => {
        if (favorites.has(comp.id)) favorites.delete(comp.id);
        else favorites.add(comp.id);
        saveFavs();
        favBtn.classList.toggle('saved', favorites.has(comp.id));
        favBtn.textContent = favorites.has(comp.id) ? '★' : '☆';
        playClick(favorites.has(comp.id) ? 720 : 420);
        if (onlyFavorites) renderGrid();
      });

      const stage = document.createElement('div');
      stage.className = 'card-stage';
      comp.mount(stage);

      const footer = document.createElement('div');
      footer.className = 'card-footer';
      footer.innerHTML = `
        <div class="card-meta">
          <div class="card-title">${comp.title}</div>
          <div class="card-cat">${comp.subtitle}</div>
        </div>
        <button class="details-btn" type="button">Details <span>→</span></button>
      `;
      footer.querySelector('.details-btn').addEventListener('click', () => {
        playClick(580);
        openModal(comp);
      });

      card.appendChild(favBtn);
      card.appendChild(stage);
      card.appendChild(footer);
      grid.appendChild(card);
    });
  }

  // Toolbar listeners
  document.getElementById('searchInput').addEventListener('input', (e) => {
    searchQuery = e.target.value;
    renderGrid();
  });

  document.getElementById('favFilterBtn').addEventListener('click', (e) => {
    onlyFavorites = !onlyFavorites;
    e.currentTarget.classList.toggle('active', onlyFavorites);
    playClick(560);
    renderGrid();
  });

  document.getElementById('colsToggle').addEventListener('click', (e) => {
    colsMode = colsMode === 'auto' ? '3' : colsMode === '3' ? '4' : 'auto';
    e.currentTarget.textContent = `Columns: ${colsMode === 'auto' ? 'Auto' : colsMode}`;
    playClick(520);
    renderGrid();
  });

  document.getElementById('soundToggle').addEventListener('click', (e) => {
    soundEnabled = !soundEnabled;
    e.currentTarget.classList.toggle('active', soundEnabled);
    document.getElementById('soundIcon').textContent = soundEnabled ? '🔊' : '🔇';
    document.getElementById('soundLabel').textContent = soundEnabled ? 'Sound On' : 'Sound Off';
    if (soundEnabled) playClick(660);
  });

  document.getElementById('modalCloseBtn').addEventListener('click', closeModal);
  document.getElementById('detailsModal').addEventListener('click', (e) => {
    if (e.target.id === 'detailsModal') closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  saveFavs();
  renderTabs();
  renderGrid();
})();
</script>
</body>
</html>