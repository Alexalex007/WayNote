<script>
(function () {
  // Rich Web Audio Tactile Foley Engine
  let audioCtx = null;
  let soundEnabled = true;

  function getCtx() {
    if (!soundEnabled) return null;
    try {
      if (!audioCtx) {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        audioCtx = new AC();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    } catch (e) {
      return null;
    }
  }

  function playClick(freq = 520, dur = 0.045, type = 'sine') {
    const ctx = getCtx();
    if (!ctx) return;
    const now = ctx.currentTime;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, now);
    osc.frequency.exponentialRampToValueAtTime(Math.max(40, freq * 0.62), now + dur);
    gain.gain.setValueAtTime(0.075, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + dur);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(now);
    osc.stop(now + dur);
  }

  const SFX = {
    // Tactile mechanical keycap thock + subtle snap
    key(high = true) {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(high ? 320 : 240, now);
      osc.frequency.exponentialRampToValueAtTime(75, now + 0.045);
      g.gain.setValueAtTime(0.14, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.052);
      // upper click transient
      const osc2 = ctx.createOscillator();
      const g2 = ctx.createGain();
      osc2.type = 'sine';
      osc2.frequency.setValueAtTime(high ? 1450 : 1050, now);
      g2.gain.setValueAtTime(0.045, now);
      g2.gain.exponentialRampToValueAtTime(0.001, now + 0.015);
      osc2.connect(g2); g2.connect(ctx.destination);
      osc2.start(now); osc2.stop(now + 0.018);
    },
    // Hardware rocker switch clack
    rocker(on) {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      [0, 0.022].forEach((offset, idx) => {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'square';
        const base = on ? (idx === 0 ? 220 : 520) : (idx === 0 ? 340 : 180);
        osc.frequency.setValueAtTime(base, now + offset);
        osc.frequency.exponentialRampToValueAtTime(90, now + offset + 0.028);
        g.gain.setValueAtTime(0.055, now + offset);
        g.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.03);
        osc.connect(g); g.connect(ctx.destination);
        osc.start(now + offset); osc.stop(now + offset + 0.032);
      });
    },
    // Bubbly rising pop (Like Burst, Pop, Bookmark)
    pop(pitch = 1) {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(280 * pitch, now);
      osc.frequency.exponentialRampToValueAtTime(860 * pitch, now + 0.075);
      g.gain.setValueAtTime(0.09, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.085);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.09);
    },
    // Soft air whoosh (Paper Plane, Drawer, Route Swap)
    whoosh(up = true) {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      const len = Math.floor(ctx.sampleRate * 0.18);
      const buf = ctx.createBuffer(1, len, ctx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / len);
      const src = ctx.createBufferSource();
      src.buffer = buf;
      const filter = ctx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.Q.value = 1.6;
      filter.frequency.setValueAtTime(up ? 400 : 1500, now);
      filter.frequency.exponentialRampToValueAtTime(up ? 1900 : 380, now + 0.16);
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.11, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
      src.connect(filter); filter.connect(g); g.connect(ctx.destination);
      src.start(now);
    },
    // Warm ascending 2-note success chime
    chime() {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      [587.33, 880].forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now + i * 0.075);
        g.gain.setValueAtTime(0.08, now + i * 0.075);
        g.gain.exponentialRampToValueAtTime(0.001, now + i * 0.075 + 0.22);
        osc.connect(g); g.connect(ctx.destination);
        osc.start(now + i * 0.075); osc.stop(now + i * 0.075 + 0.24);
      });
    },
    // Precision mechanical detent tick (Sliders, Segmented controls)
    tick(pitch = 1) {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(1100 * pitch, now);
      osc.frequency.exponentialRampToValueAtTime(320 * pitch, now + 0.018);
      g.gain.setValueAtTime(0.06, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.02);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.022);
    },
    // Elastic spring boing (Bounce, Jelly, Squeeze, Stretch Toggle)
    boing(pitch = 1) {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(210 * pitch, now);
      osc.frequency.exponentialRampToValueAtTime(520 * pitch, now + 0.07);
      osc.frequency.exponentialRampToValueAtTime(310 * pitch, now + 0.15);
      g.gain.setValueAtTime(0.085, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.17);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.18);
    },
    // Liquid bloop (Ink Switch, Gooey Tab Bar)
    liquid(up = true) {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(up ? 260 : 540, now);
      osc.frequency.exponentialRampToValueAtTime(up ? 640 : 250, now + 0.11);
      g.gain.setValueAtTime(0.09, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.13);
    },
    // Low warning buzz / thud (Shake, Hold Delete, Jerk)
    warn() {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(155, now);
      osc.frequency.linearRampToValueAtTime(110, now + 0.14);
      g.gain.setValueAtTime(0.06, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.16);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.17);
    },
    // Electric flicker zap (Flicker)
    zap() {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      [0, 0.055, 0.11].forEach((t, i) => {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(920 - i * 160, now + t);
        g.gain.setValueAtTime(0.032, now + t);
        g.gain.exponentialRampToValueAtTime(0.001, now + t + 0.025);
        osc.connect(g); g.connect(ctx.destination);
        osc.start(now + t); osc.stop(now + t + 0.028);
      });
    },
    // Telemetry radar ping (Live pill)
    ping() {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(1046.5, now);
      g.gain.setValueAtTime(0.065, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.3);
    },
    // Crisp bell ring (Price Alert Bell)
    bell() {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      [1318.5, 1975.5].forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now);
        g.gain.setValueAtTime(i === 0 ? 0.075 : 0.035, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + 0.32);
        osc.connect(g); g.connect(ctx.destination);
        osc.start(now); osc.stop(now + 0.34);
      });
    },
    // Passport rubber stamp thud (Itinerary Save Stamp)
    stamp() {
      const ctx = getCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(160, now);
      osc.frequency.exponentialRampToValueAtTime(48, now + 0.08);
      g.gain.setValueAtTime(0.18, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.1);
    }
  };

  // Toast helper
  let toastTimer = null;
  function showToast(msg) {
    const el = document.getElementById('toast');
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.remove('show'), 1800);
  }

  // Copy text helper with execCommand fallback
  function copyText(text) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
    } else {
      fallbackCopy(text);
    }
  }
  function fallbackCopy(text) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
  }

  // Component definitions (30 items matching the video)
  const COMPONENTS = [
    // === BUTTONS (10) ===
    {
      id: 'squash-play',
      title: 'Squash Play Key',
      subtitle: 'Button',
      category: 'Buttons',
      desc: '按壓時產生鍵帽擠壓形變（scaleX 放大、scaleY 壓扁）與立體陰影回彈，並切換播放／暫停圖示。',
      code: `.squash-key:active {\n  transform: translateY(6px) scaleX(1.12) scaleY(0.84);\n  box-shadow: 0 1px 0 #71717a;\n}`,
      mount(container) {
        let playing = false;
        const btn = document.createElement('button');
        btn.className = 'squash-key';
        btn.type = 'button';
        btn.setAttribute('aria-label', 'Play or Pause');
        const render = () => {
          btn.innerHTML = playing
            ? '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4.5" height="14" rx="1.5"/><rect x="13.5" y="5" width="4.5" height="14" rx="1.5"/></svg>'
            : '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>';
        };
        render();
        btn.addEventListener('click', () => {
          playing = !playing;
          btn.classList.add('squashed');
          SFX.key(playing);
          setTimeout(() => btn.classList.remove('squashed'), 140);
          render();
        });
        container.appendChild(btn);
      }
    },
    {
      id: 'drawer-btn',
      title: 'Drawer',
      subtitle: 'Button · Open settings',
      category: 'Buttons',
      desc: '點擊「Open settings」按鈕後，由底部彈出半透明磨砂設定抽屜面板，可即時切換內部選項或關閉。',
      code: `.mini-drawer-sheet {\n  transform: translateY(100%);\n  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);\n}\n.mini-drawer.open .mini-drawer-sheet { transform: translateY(0); }`,
      mount(container) {
        const btn = document.createElement('button');
        btn.className = 'open-settings-btn';
        btn.type = 'button';
        btn.textContent = 'Open settings';

        const drawer = document.createElement('div');
        drawer.className = 'mini-drawer';
        drawer.innerHTML = `
          <div class="mini-drawer-sheet">
            <div class="drawer-handle"></div>
            <div class="drawer-row">
              <span>Reduced motion</span>
              <button type="button" class="drawer-close" data-act="toggle">Off</button>
            </div>
            <div class="drawer-row">
              <span>Haptics</span>
              <button type="button" class="drawer-close" data-act="close">Done</button>
            </div>
          </div>
        `;
        btn.addEventListener('click', () => {
          drawer.classList.add('open');
          SFX.whoosh(true);
        });
        drawer.addEventListener('click', (e) => {
          const act = e.target.getAttribute('data-act');
          if (act === 'toggle') {
            e.target.textContent = e.target.textContent === 'Off' ? 'On' : 'Off';
            playClick(640);
          } else if (act === 'close' || e.target === drawer) {
            drawer.classList.remove('open');
            SFX.whoosh(false);
          }
        });
        container.appendChild(btn);
        container.appendChild(drawer);
      }
    },
    {
      id: 'like-burst',
      title: 'Like Burst',
      subtitle: 'Button',
      category: 'Buttons',
      desc: '點擊愛心時觸發 8 顆徑向擴散微粒子爆裂與彈性縮放，並同步更新按讚數字。',
      code: `@keyframes burstFly {\n  0% { transform: translate(0,0) scale(1); opacity: 1; }\n  100% { transform: translate(var(--dx), var(--dy)) scale(0); opacity: 0; }\n}`,
      mount(container) {
        let liked = false;
        let count = 128;
        const btn = document.createElement('button');
        btn.className = 'like-btn';
