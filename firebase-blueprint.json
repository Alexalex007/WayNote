{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile for Waynote cross-device sync and theme preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document owner.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Publicly formatted user display name.",
          "maxLength": 100
        },
        "providerId": {
          "type": "string",
          "description": "Authentication provider identifier such as google.com or apple.com.",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account profile was initialized."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest profile update."
        }
      },
      "required": ["uid", "displayName", "providerId", "createdAt", "updatedAt"]
    },
    "UserTrip": {
      "title": "UserTrip",
      "description": "Private cloud-synced trip record scoped strictly under the authenticated owner.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique trip identifier.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Authenticated owner UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "syncId": {
          "type": "string",
          "description": "Optional companion sync room code.",
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Trip title.",
          "minLength": 1,
          "maxLength": 120
        },
        "destination": {
          "type": "string",
          "description": "Destination city or multi-stop route summary.",
          "minLength": 1,
          "maxLength": 200
        },
        "startDate": {
          "type": "string",
          "description": "Departure date in YYYY-MM-DD.",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "type": "string",
          "description": "Return date in YYYY-MM-DD.",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "type": {
          "type": "string",
          "enum": ["Single", "Multi"],
          "description": "Single destination or multi-city route."
        },
        "archived": {
          "type": "boolean",
          "description": "Whether the trip is archived."
        },
        "revision": {
          "type": "number",
          "description": "Monotonic sync revision number."
        },
        "clientUpdatedAt": {
          "type": "number",
          "description": "Client millisecond timestamp used for CRDT merge."
        },
        "metaUpdatedAt": {
          "type": "number",
          "description": "Metadata modification timestamp."
        },
        "budgetUpdatedAt": {
          "type": "number",
          "description": "Budget modification timestamp."
        },
        "stops": {
          "type": "array",
          "description": "Multi-city stops array."
        },
        "hotels": {
          "type": "array",
          "description": "Hotel accommodation bookings."
        },
        "activities": {
          "type": "object",
          "description": "Daily itinerary activities keyed by YYYY-MM-DD."
        },
        "activitiesOrderUpdatedAt": {
          "type": "object",
          "description": "Per-day reorder timestamps."
        },
        "themes": {
          "type": "object",
          "description": "Per-day itinerary titles keyed by YYYY-MM-DD."
        },
        "themesUpdatedAt": {
          "type": "object",
          "description": "Per-day theme timestamps."
        },
        "expenses": {
          "type": "array",
          "description": "Pre-trip and on-trip expense records."
        },
        "packingList": {
          "type": "array",
          "description": "User toolbox packing checklist items."
        },
        "documents": {
          "type": "array",
          "description": "Travel bookings, vouchers, and references."
        },
        "budget": {
          "type": "object",
          "description": "Trip budget configuration and base currency."
        },
        "tombstones": {
          "type": "object",
          "description": "Deleted entity IDs mapped to deletion timestamps."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of document creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "id",
        "ownerId",
        "syncId",
        "name",
        "destination",
        "startDate",
        "endDate",
        "type",
        "archived",
        "revision",
        "clientUpdatedAt",
        "metaUpdatedAt",
        "budgetUpdatedAt",
        "stops",
        "hotels",
        "activities",
        "activitiesOrderUpdatedAt",
        "themes",
        "themesUpdatedAt",
        "expenses",
        "packingList",
        "documents",
        "budget",
        "tombstones",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Real-time cross-device session heartbeat scoped under the authenticated owner.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique browser/device session identifier.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Authenticated owner UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tripId": {
          "type": "string",
          "description": "Currently active trip ID or HOME.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "description": "Human-readable device label such as iPhone or Mac.",
          "minLength": 1,
          "maxLength": 60
        },
        "clientUpdatedAt": {
          "type": "number",
          "description": "Client millisecond heartbeat timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest presence heartbeat."
        }
      },
      "required": ["id", "ownerId", "tripId", "deviceName", "clientUpdatedAt", "updatedAt"]
    },
    "UserFileManifest": {
      "title": "UserFileManifest",
      "description": "Metadata manifest for chunked cross-device travel document files.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique cloud file identifier.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Authenticated owner UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tripId": {
          "type": "string",
          "description": "Associated trip identifier.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileName": {
          "type": "string",
          "description": "Original file name.",
          "minLength": 1,
          "maxLength": 255
        },
        "mimeType": {
          "type": "string",
          "description": "MIME type of the stored file.",
          "minLength": 1,
          "maxLength": 120
        },
        "fileSize": {
          "type": "number",
          "description": "Byte length of the stored file."
        },
        "chunkCount": {
          "type": "number",
          "description": "Total number of base64 chunks stored under this manifest."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when file upload was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest manifest update."
        }
      },
      "required": ["id", "ownerId", "tripId", "fileName", "mimeType", "fileSize", "chunkCount", "createdAt", "updatedAt"]
    },
    "UserFileChunk": {
      "title": "UserFileChunk",
      "description": "Base64-encoded binary slice of a user travel document (< 700 KB per doc).",
      "type": "object",
      "properties": {
        "index": {
          "type": "number",
          "description": "Zero-based chunk order index."
        },
        "ownerId": {
          "type": "string",
          "description": "Authenticated owner UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileId": {
          "type": "string",
          "description": "Parent file manifest ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "data": {
          "type": "string",
          "description": "Base64 slice payload.",
          "minLength": 1,
          "maxLength": 700000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of chunk creation."
        }
      },
      "required": ["index", "ownerId", "fileId", "data", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile document isolated per authenticated UID."
    },
    "/users/{userId}/trips/{tripId}": {
      "schema": { "$ref": "#/entities/UserTrip" },
      "description": "Private trips owned by a user, synced in real time across their signed-in devices."
    },
    "/users/{userId}/presence/{sessionId}": {
      "schema": { "$ref": "#/entities/UserPresence" },
      "description": "Real-time cross-device session heartbeat for accurate live device count across domains."
    },
    "/users/{userId}/files/{fileId}": {
      "schema": { "$ref": "#/entities/UserFileManifest" },
      "description": "Manifest metadata for uploaded travel documents synced across devices."
    },
    "/users/{userId}/files/{fileId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/UserFileChunk" },
      "description": "Ordered binary chunks belonging to a cloud-synced travel document."
    }
  }
}
